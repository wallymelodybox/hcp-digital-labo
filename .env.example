# Obligatoire en production : utilisez des valeurs longues, uniques et stockées
# dans le gestionnaire de secrets de votre hébergeur.
ADMIN_USER=
ADMIN_PASSWORD=

# Kadev Pay : ne jamais préfixer ces secrets avec NEXT_PUBLIC_.
KADEV_SECRET_KEY=
KADEV_WEBHOOK_SECRET=
NEXT_PUBLIC_KADEV_PUBLIC_KEY=

# Optionnel si la migration vers Supabase est activée.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Clé Bearer longue et aléatoire utilisée uniquement par l'application mobile.
CHAT_MOBILE_API_KEY=
